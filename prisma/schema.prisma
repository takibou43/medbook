  @@map("ai_messages")
}

// ---------------- Audit ----------------

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String?
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("audit_logs")
}

// ---------------- Web Push ----------------

// اشتراك متصفح واحد في إشعارات Push (لكل جهاز/متصفح سجل مستقل، فقد يستعمل الطبيب
// هاتفه وحاسوبه معًا). endpoint فريد لأنه هو معرّف الاشتراك لدى خدمة الدفع في المتصفح.
// عند رفض الخدمة للاشتراك (410/404) نحذف السجل تلقائيًا لأنه لم يعد صالحًا.
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("push_subscriptions")
}

// ---------------- Admin <-> Doctor messaging ----------------

// محادثة واحدة فقط لكل طبيب (doctorId فريد) بين الإدارة (كل حسابات ADMIN كفريق واحد) والطبيب.
// لا توجد محادثات طبيب-طبيب ولا محادثات مع مساعد أو مريض: لا مفتاح خارجي ولا مسار يسمح بذلك.
// lastMessage* حقول مُكرَّرة عمدًا لعرض قائمة المحادثات بلا استعلام لكل صف (لا N+1).
model DoctorConversation {
  id                 String    @id @default(uuid())
  doctorId           String    @unique
  doctor             Doctor    @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  lastMessageAt      DateTime?
  lastMessagePreview String?
  lastSenderRole     Role?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  messages DoctorMessage[]

  @@index([lastMessageAt])
  @@map("doctor_conversations")
}

// senderId يُشتق دائمًا من الجلسة في الخادم (لا يأتي من الواجهة). senderRole إمّا ADMIN أو DOCTOR فقط.
// clientId: معرّف يولّده العميل لكل رسالة لمنع التكرار عند إعادة الطلب/انقطاع الشبكة.
// readAt: وقت قراءة الطرف الآخر للرسالة (null = غير مقروءة).
model DoctorMessage {
  id             String             @id @default(uuid())
  conversationId String
  conversation   DoctorConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  senderRole     Role
  content        String
  clientId       String?
  readAt         DateTime?
  createdAt      DateTime           @default(now())

  @@unique([conversationId, senderId, clientId])
  @@index([conversationId, createdAt])
  @@index([senderRole, readAt])
  @@map("doctor_messages")
}

// ---------------- Patient appointment reminders (Web Push) ----------------

// نوع التذكير: قبل الموعد بساعة، وقبل الموعد بخمس دقائق. لا يوجد تذكير 24 ساعة.
enum ReminderType {
  ONE_HOUR
  FIVE_MINUTES
  // «دورك اقترب»: يُحسب من موقع المريض الفعلي في طابور الطبيب والمدة الذكية، لا من وقت الموعد وحده.
  // سجل واحد لكل موعد (القيد الفريد appointmentId+type) = إرسال مرة واحدة فقط لهذه المرحلة.
  QUEUE_APPROACH
}

// PENDING: أُنشئ ولم يُعالَج بعد. PROCESSING: حجزه مُشغِّل واحد (قفل ذرّي عبر updateMany المشروط).
// SENT: وصل لجهاز واحد على الأقل. SKIPPED: لم يُرسل عمدًا (موعد ملغى/مكتمل/غائب، فات الوقت، لا أجهزة).
// FAILED: رفضته كل الأجهزة. أي حالة غير PENDING نهائية: لا يُعاد إرسال التذكير أبدًا.
enum ReminderStatus {
  PENDING
  PROCESSING
  SENT
  SKIPPED
  FAILED
}

// تذكير واحد لكل (موعد + نوع) بفضل القيد الفريد، فلو اشتغل الـscheduler مرتين أو على نسختين
// من الخادم في نفس اللحظة لا يُنشأ ولا يُرسل نفس التذكير مرتين. لا يحمل أي بيانات طبية.
model AppointmentReminder {
  id            String         @id @default(uuid())
  appointmentId String
  appointment   Appointment    @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  type          ReminderType
  scheduledFor  DateTime
  status        ReminderStatus @default(PENDING)
  sentAt        DateTime?
  // عدد الأجهزة التي وصلها الإشعار، وسبب التخطي/الفشل (نص تقني قصير، بلا بيانات شخصية).
  deliveredCount Int           @default(0)
  skipReason    String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([appointmentId, type])
  @@index([status, scheduledFor])
  @@map("appointment_reminders")
}

// ---------------- Queue: late events ----------------

// حدث «متأخر» واحد: نودي المريض فلم يحضر فسُجّل متأخرًا. عدّاد التأخير نفسه هو Appointment.deferredCount
// (مرتبط بالموعد لا بالمريض، فيبدأ من صفر في كل موعد جديد)، وهذا الجدول سجلّه القابل للتتبّع:
// sequence = رقم التأخير في هذا الموعد (1، 2، 3...) و penalty = المراكز التي تراجعها (2 ثم 4 لكل تأخير لاحق).
// القيد الفريد (appointmentId, sequence) يمنع احتساب نفس التأخير مرتين حتى مع طلبين متزامنين،
// ومعرّف الحدث هو ما يربط إشعار المريض بهذا التأخير تحديدًا (لا إشعار مكرر لنفس الحدث).
model AppointmentLateEvent {
  id            String      @id @default(uuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  sequence      Int
  penalty       Int
  // حساب الطبيب أو المساعد الذي سجّل التأخير (للتتبّع فقط).
  actorUserId   String?
  createdAt     DateTime    @default(now())

  @@unique([appointmentId, sequence])
  @@map("appointment_late_events")
}

// ---------------- Dental treatment plans ----------------

// خطة علاج أسنان متعددة الجلسات — عامة (لا إجراء ثابت). يملكها طبيب واحد (doctorId من الجلسة فقط)
// لمريض صاحب حساب، واختياريًا لأحد أفراد عائلته. لا تُحذف أبدًا (إكمال/إلغاء فقط)، لذلك كل العلاقات
// Restrict: لا حذف متسلسل لتاريخ طبي.
model DentalTreatmentPlan {
  id                 String              @id @default(uuid())
  doctorId           String
  doctor             Doctor              @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  patientId          String
  patient            Patient             @relation(fields: [patientId], references: [id], onDelete: Restrict)
  familyMemberId     String?
  familyMember       FamilyMember?       @relation(fields: [familyMemberId], references: [id], onDelete: Restrict)
  title              String
  description        String?
  status             TreatmentPlanStatus @default(ACTIVE)
  estimatedSessions  Int?
  // بالدينار الجزائري (عدد صحيح، مثل consultationFee).
  estimatedTotalCost Int?
  startedAt          DateTime            @default(now())
  completedAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  sessions     DentalTreatmentSession[]
  followUps    DentalFollowUp[]
  appointments Appointment[]

  @@index([doctorId])
  @@index([patientId])
  @@index([familyMemberId])
  @@map("dental_treatment_plans")
}

model DentalTreatmentSession {
  id              String                 @id @default(uuid())
  treatmentPlanId String
  treatmentPlan   DentalTreatmentPlan    @relation(fields: [treatmentPlanId], references: [id], onDelete: Restrict)
  // موعد قائم يخص نفس الطبيب ونفس المستفيد (فريد: الموعد الواحد لا يحقق جلستين).
  appointmentId   String?                @unique
  appointment     Appointment?           @relation("SessionAppointment", fields: [appointmentId], references: [id], onDelete: SetNull)
  sessionNumber   Int
  title           String
  notes           String?
  plannedDate     DateTime?
  completedAt     DateTime?
  status          TreatmentSessionStatus @default(PLANNED)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  followUpAppointments Appointment[] @relation("SessionFollowUps")

  @@index([treatmentPlanId])
  @@map("dental_treatment_sessions")
}

model DentalFollowUp {
  id              String               @id @default(uuid())
  treatmentPlanId String
  treatmentPlan   DentalTreatmentPlan  @relation(fields: [treatmentPlanId], references: [id], onDelete: Restrict)
  dueDate         DateTime
  status          DentalFollowUpStatus @default(DUE)
  // موعد العودة الفعلي الذي حُوّلت إليه المتابعة (SCHEDULED). يُفرَّغ ويعود DUE إن أُلغي الموعد.
  appointmentId   String?              @unique
  appointment     Appointment?         @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  completedAt     DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([treatmentPlanId, dueDate])
  @@map("dental_follow_ups")
}

// ---------------- Doctor referrals ----------------

// إحالة طبيب لزميل: سجل واحد فقط لكل طبيب مُحال (referredDoctorId فريد) يُنشأ لحظة تسجيله ولا يتغيّر.
// المكافأة (30 يومًا للمُحيل فقط) تُمنح مرة واحدة داخل نفس معاملة توثيق الطبيب المُحال — انظر
// modules/referrals/referrals.service.ts. حذف أحد الطبيبين يحذف سجل الإحالة (AuditLog يبقى أثرًا).
model DoctorReferral {
  id               String               @id @default(uuid())
  referrerDoctorId String
  referrer         Doctor               @relation("ReferralReferrer", fields: [referrerDoctorId], references: [id], onDelete: Cascade)
  referredDoctorId String               @unique
  referred         Doctor               @relation("ReferralReferred", fields: [referredDoctorId], references: [id], onDelete: Cascade)
  referralCodeUsed String
  status           DoctorReferralStatus @default(PENDING)
  qualifiedAt      DateTime?
  rewardedAt       DateTime?
  rewardDays       Int                  @default(30)
  rewardClinicId   String?
  rewardClinic     Clinic? @relation("ClinicReferralRewards", fields: [rewardClinicId], references: [id], onDelete: Restrict)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([rewardClinicId])
  @@index([referrerDoctorId])
  @@map("doctor_referrals")
}


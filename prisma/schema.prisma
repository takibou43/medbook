// ============================================================
// MedBook — Prisma Schema
// PostgreSQL
// ============================================================

generator client {
  provider = "prisma-client-js"
  output   = "../backend/node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------- Enums ----------------

enum Role {
  CLINIC_OWNER
  PATIENT
  DOCTOR
  ADMIN
  // مساعد الطبيب: حساب دخول مستقل (بريد/كلمة مرور خاصين به) يعمل نيابة عن طبيب واحد
  // محدد (انظر نموذج Assistant أدناه)، بصلاحيات محدودة دون بيانات الطبيب المالية أو الإدارية.
  ASSISTANT
}

// حالة دعوة مساعد أرسلها الطبيب عبر البريد الإلكتروني. الرابط المُرسل للمساعد لا يحمل
// إلا رمزًا عشوائيًا (يُخزَّن هنا مُجزَّأً لا نصًا صريحًا، بنفس نمط RefreshToken.tokenHash)،
// ولا يمكن استعماله إلا مرة واحدة (يتحول إلى ACCEPTED فيُرفض أي استعمال لاحق).
enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum Gender {
  MALE
  FEMALE
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  // غيّر الطبيب دوامه فأصبح الوقت المحجوز غير متاح؛ يبقى الموعد محفوظًا حتى يعيد المريض ترتيبه أو يلغيه.
  RESCHEDULE_REQUIRED
  // المريض الجالس الآن أمام الطبيب (نودي عليه ودخل).
  IN_PROGRESS
  // نودي عليه فلم يستجب: لا يُشطب، بل ينتظر في قائمة "متأخر" ويُعاد نداؤه لاحقًا.
  LATE
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

// حالة اشتراك الطبيب المدفوع في المنصة. UNPAID هي الحالة الافتراضية لكل طبيب جديد
// يسجّل من الآن فصاعدًا — لا يظهر للمرضى ولا يمكن حجز موعد معه حتى تصبح ACTIVE.
// الأطباء المسجَّلون قبل إضافة هذه الميزة يُثبَّتون على ACTIVE تلقائيًا (انظر ملف الترحيل)
// حتى لا يختفوا فجأة من الموقع. لا يوجد حاليًا أي واجهة دفع فعلية مرتبطة بهذا الحقل —
// إعداد تقني تمهيدي فقط، بانتظار حساب "تاجر إلكتروني" لدى بريد الجزائر (BaridiMob).
enum SubscriptionStatus {
  UNPAID
  ACTIVE
  EXPIRED
}

enum ConsultationType {
  IN_PERSON
  FOLLOW_UP
  ONLINE
}

// نتيجة محاولة إرسال SMS لتنبيه "لم يحضر" — سجل واحد فقط لكل موعد (انظر SmsLog أدناه)
// لمنع إعادة المحاولة العشوائية سواء نجحت المحاولة الأولى أم فشلت.
enum SmsStatus {
  SENT
  FAILED
}

// من أنشأ الموعد (للتدقيق وللتمييز في الواجهات). المواعيد القديمة تُملأ في الترحيل: بلا patientId → GUEST، وإلا PATIENT.
enum AppointmentCreatedBy {
  PATIENT
  DOCTOR
  ADMIN
  GUEST
}

// صلة القرابة بين صاحب الحساب وفرد العائلة الذي يُحجز له.
enum FamilyRelationship {
  CHILD
  SPOUSE
  PARENT
  SIBLING
  OTHER
}

enum TreatmentPlanStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum TreatmentSessionStatus {
  PLANNED
  COMPLETED
  CANCELLED
}

// DUE: مستحقة بلا موعد. SCHEDULED: رُبطت بموعد عودة فعلي (لا تُعتبر مكتملة بمجرد الحجز).
// COMPLETED: اكتمل الموعد أو حدّدها الطبيب يدويًا. DISMISSED: تجاهلها الطبيب.
enum DentalFollowUpStatus {
  DUE
  SCHEDULED
  COMPLETED
  DISMISSED
}

// PENDING: سُجّل الطبيب المُحال بالكود. QUALIFIED/REWARDED: وثّقته الإدارة ومُنحت المكافأة مرة واحدة.
// REJECTED: رفضت الإدارة توثيق الطبيب المُحال (يمكن أن تُمنح لاحقًا إن وُثّق فعلًا).
enum DoctorReferralStatus {
  PENDING
  QUALIFIED
  REWARDED
  REJECTED
}

// ---------------- Core identity ----------------

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  phone        String?  @unique
  passwordHash String
  role         Role
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  patient         Patient?
  doctor          Doctor?
  notifications   Notification[]
  auditLogs       AuditLog[]
  favorites       Favorite[]
  aiConversations AiConversation[]
  refreshTokens   RefreshToken[]
  pushSubscriptions PushSubscription[]
  assistant         Assistant?
  ownedClinic       Clinic? @relation("ClinicOwner")

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// ---------------- Geography ----------------

model Wilaya {
  id     String  @id @default(uuid())
  code   String  @unique
  nameAr String
  nameFr String?

  cities  City[]
  doctors Doctor[]
  clinics Clinic[]

  @@map("wilayas")
}

model City {
  id       String @id @default(uuid())
  nameAr   String
  wilayaId String
  wilaya   Wilaya @relation(fields: [wilayaId], references: [id], onDelete: Cascade)

  doctors Doctor[]
  clinics Clinic[]
  patients Patient[]

  @@index([wilayaId])
  @@map("cities")
}

// ---------------- Medical taxonomy ----------------

model Specialty {
  id          String  @id @default(uuid())
  nameAr      String  @unique
  nameFr      String?
  icon        String?
  description String?

  doctors Doctor[]

  @@map("specialties")
}

model MedicalService {
  id          String @id @default(uuid())
  nameAr      String
  durationMin Int    @default(30)
  price       Int?

  appointmentServices AppointmentService[]

  @@map("medical_services")
}

model Clinic {
  id       String @id @default(uuid())
  nameAr   String
  address  String
  phone    String?
  wilayaId String
  wilaya   Wilaya @relation(fields: [wilayaId], references: [id])
  cityId   String
  city     City   @relation(fields: [cityId], references: [id])
  ownerId String? @unique
  owner User? @relation("ClinicOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  description String?
  photoUrl String?
  verificationStatus VerificationStatus @default(PENDING)
  subscriptionStatus SubscriptionStatus @default(UNPAID)
  subscriptionExpiresAt DateTime?
  paidDoctorCount Int @default(0)
  referralDiscountUntil DateTime?
  pendingReferralDays Int @default(0)
  referralRewards DoctorReferral[] @relation("ClinicReferralRewards")
  createdAt DateTime @default(now())
  doctorInvites ClinicDoctorInvite[]
  transferRequests ClinicTransferRequest[]

  doctors Doctor[]

  @@index([wilayaId, cityId])
  @@map("clinics")
}

// ---------------- Patients & Doctors ----------------

model Patient {
  id        String    @id @default(uuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName String
  lastName  String
  birthDate DateTime?
  gender    Gender?
  cityId    String?
  city      City?     @relation(fields: [cityId], references: [id], onDelete: SetNull)

  appointments Appointment[]
  reviews      Review[]
  blocks       PatientBlock[]
  // أفراد العائلة الذين يحجز لهم صاحب الحساب (بلا حسابات دخول مستقلة).
  familyMembers  FamilyMember[]
  treatmentPlans DentalTreatmentPlan[]

  @@index([cityId])
  @@map("patients")
}

model ClinicDoctorInvite {
  id String @id @default(uuid())
  clinicId String
  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  email String
  tokenHash String @unique
  status InviteStatus @default(PENDING)
  expiresAt DateTime
  createdAt DateTime @default(now())
  acceptedAt DateTime?
  @@index([clinicId, status])
  @@map("clinic_doctor_invites")
}

model ClinicTransferRequest {
  id String @id @default(uuid())
  clinicId String
  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  doctorId String
  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  pendingDoctorId String? @unique
  status InviteStatus @default(PENDING)
  createdAt DateTime @default(now())
  reviewedAt DateTime?
  reviewedBy String?
  @@index([clinicId, status])
  @@map("clinic_transfer_requests")
}
// فرد عائلة يحجز له صاحب الحساب من حسابه نفسه — لا User ولا بيانات دخول ولا هاتف خاص به.
// ownerPatientId لا يتغيّر بعد الإنشاء (لا مسار يسمح بذلك). الحذف = أرشفة (archivedAt) فقط:
// يختفي من الاختيارات الجديدة وتبقى مواعيده وخطط علاجه كما هي. onDelete: Restrict حتى لا يُحذف
// سجل طبي بالخطأ عبر حذف متسلسل.
model FamilyMember {
  id             String              @id @default(uuid())
  ownerPatientId String
  ownerPatient   Patient             @relation(fields: [ownerPatientId], references: [id], onDelete: Restrict)
  firstName      String
  lastName       String
  birthDate      DateTime?
  gender         Gender?
  relationship   FamilyRelationship
  archivedAt     DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  appointments   Appointment[]
  treatmentPlans DentalTreatmentPlan[]

  @@index([ownerPatientId])
  @@map("family_members")
}

// نوع الحظر: يدوي من الإدارة، أو تلقائي بعد 3 غيابات NO_SHOW خلال 7 أيام.
enum PatientBlockType {
  MANUAL
  AUTOMATIC
}

// سجل حظر المريض من إنشاء حجوزات جديدة (سجل لكل عملية حظر، ويُغلق عند إلغاء الحظر فيبقى التاريخ كاملًا).
// activePatientId = patientId ما دام الحظر ساريًا، ويصير NULL عند الإلغاء. القيد الفريد عليه يضمن
// حظرًا ساريًا واحدًا على الأكثر لكل مريض حتى مع طلبين متزامنين (NULL لا يتعارض في PostgreSQL).
// blockedBy/unblockedBy = معرّف حساب الإدارة (بلا مفتاح أجنبي، كي لا يضيع السجل إن حُذف حساب المدير).
model PatientBlock {
  id              String    @id @default(uuid())
  patientId       String
  patient         Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  activePatientId String?   @unique
  reason          String?
  // يدوي (من الإدارة) أو تلقائي — للحظر التلقائي: noShowCount = عدد الغيابات داخل النافذة لحظة الحظر.
  blockType       PatientBlockType @default(MANUAL)
  noShowCount     Int?
  blockedAt       DateTime  @default(now())
  blockedBy       String?
  unblockedAt     DateTime?
  unblockedBy     String?

  @@index([patientId])
  @@map("patient_blocks")
}
model Doctor {
  clinicTransferRequests ClinicTransferRequest[]
  id          String    @id @default(uuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName   String
  lastName    String
  specialtyId String
  specialty   Specialty @relation(fields: [specialtyId], references: [id])
  clinicId    String?
  clinic      Clinic?   @relation(fields: [clinicId], references: [id])
  wilayaId    String
  wilaya      Wilaya    @relation(fields: [wilayaId], references: [id])
  cityId      String
  city        City      @relation(fields: [cityId], references: [id])
  bio         String?
  yearsExperience Int    @default(0)
  languages       String[] @default([])
  gender          Gender?
  phone           String?
  address         String?
  consultationFee Int?
  photoUrl        String?
  // إحداثيات موقع العيادة/الطبيب — اختيارية تمامًا (nullable)، تُستعمل فقط لحساب المسافة
  // من موقع المريض (Haversine) وفتح الملاحة نحو العيادة. لا تُملأ تلقائيًا؛ الطبيب يضبطها
  // بنفسه من إعدادات حسابه (زر "استخدم موقعي الحالي") — لا جيوكودينغ ولا خدمة مدفوعة.
  latitude        Float?
  longitude       Float?
  // مدة الجلسة بالدقائق — يحددها الطبيب، وعليها يبني النظام ترتيب المواعيد تلقائيًا.
  slotDurationMin Int                @default(7)
  verificationStatus VerificationStatus @default(PENDING)
  // اشتراك الطبيب المدفوع في المنصة — انظر تعليق enum SubscriptionStatus أعلاه.
  subscriptionStatus SubscriptionStatus @default(UNPAID)
  subscriptionExpiresAt DateTime?
  avgRating   Float    @default(0)
  // Existing accounts retain the legacy trial; only new registrations opt in.
  newDoctorTrial Boolean @default(false)
  trialStartedAt DateTime?
  reviewsCount Int     @default(0)
  // كود الإحالة الخاص بالطبيب (يُولَّد عند أول فتح لبطاقة «ادعُ طبيبًا»، عشوائي وغير قابل للتخمين بسهولة).
  referralCode String? @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  referralsMade  DoctorReferral[]      @relation("ReferralReferrer")
  referredBy     DoctorReferral?       @relation("ReferralReferred")
  treatmentPlans DentalTreatmentPlan[]
  schedules    DoctorSchedule[]
  appointments Appointment[]
  reviews      Review[]
  documents    DoctorDocument[]
  favorites    Favorite[]
  assistants       Assistant[]
  assistantInvites AssistantInvite[]
  // إشعارات المرضى التي أُنشئت عند توثيق هذا الطبيب في ولايتهم.
  newDoctorNotifications Notification[] @relation("NewDoctorNotifications")
  // محادثة الإدارة مع هذا الطبيب (واحدة فقط) — علاقة عكسية بلا أي عمود جديد في جدول doctors.
  conversation     DoctorConversation?

  @@index([specialtyId, wilayaId, cityId])
  @@map("doctors")
}

// ---------------- Assistants (staff accounts) ----------------

// مساعد طبيب — حساب دخول مستقل (User بدور ASSISTANT) مرتبط بطبيب واحد وعيادته.
// isActive هو مفتاح التعطيل الفوري: الطبيب يعطّله من "إدارة المساعدين" فيُقطع وصوله من
// الـ Backend مباشرة (انظر resolveActingDoctorId في backend/src/lib/actingDoctor.ts)،
// وليس فقط إخفاءه في الواجهة.
model Assistant {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  doctorId  String
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  firstName String
  lastName  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([doctorId])
  @@map("assistants")
}

// دعوة مساعد يُرسلها الطبيب لبريد إلكتروني محدد. tokenHash مُجزَّأ (SHA-256) لا نصًا
// صريحًا — الرابط الفعلي يُبنى في الواجهة من الرمز الخام الذي لا يُخزَّن أبدًا. صلاحية
// زمنية (expiresAt) وحالة (status) تمنعان إعادة استعمال رابط دعوة سبق قبوله أو انتهى.
model AssistantInvite {
  id         String       @id @default(uuid())
  doctorId   String
  doctor     Doctor       @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  email      String
  tokenHash  String       @unique
  status     InviteStatus @default(PENDING)
  expiresAt  DateTime
  createdAt  DateTime     @default(now())
  acceptedAt DateTime?
  revokedAt  DateTime?

  @@index([doctorId])
  @@map("assistant_invites")
}

model DoctorDocument {
  id        String   @id @default(uuid())
  doctorId  String
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  title     String
  fileUrl   String
  createdAt DateTime @default(now())

  @@map("doctor_documents")
}

// weekly recurring slots OR one-off exceptions (day off / extra day)
model DoctorSchedule {
  id            String    @id @default(uuid())
  doctorId      String
  doctor        Doctor    @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  dayOfWeek     Int? // 0=Sunday .. 6=Saturday, null when isException=true
  startTime     String // "08:00"
  endTime       String // "12:00"
  isException   Boolean   @default(false)
  exceptionDate DateTime? // specific calendar date
  isOff         Boolean   @default(false) // true => doctor unavailable that slot/date

  @@index([doctorId])
  @@map("doctor_schedules")
}

// ---------------- Appointments ----------------

model Appointment {
  id        String   @id @default(uuid())
  patientId String?
  patient   Patient? @relation(fields: [patientId], references: [id])
  // حجز الضيف (بدون حساب/تسجيل دخول): يُملأ عند patientId = null
  guestFirstName String?
  guestLastName  String?
  guestPhone     String?
  doctorId  String
  doctor    Doctor   @relation(fields: [doctorId], references: [id])
  date      DateTime // calendar date (time truncated to 00:00 UTC)
  startTime String // "09:00"
  endTime   String // "09:30"
  type      ConsultationType  @default(IN_PERSON)
  status    AppointmentStatus @default(PENDING)
  notes     String?
  // آخر وقت أُرسل فيه تذكير SMS تلقائي للمريض قبل موعده — null يعني لم يُرسل بعد.
  // نستعملها لتفادي إرسال أكثر من تذكير واحد لنفس الموعد.
  reminderSentAt DateTime?
  // ---- إدارة طابور العيادة اليومي ----
  // وقت مناداة المريض من طرف الطبيب (آخر مناداة).
  calledAt              DateTime?
  // كم مرة نودي عليه فلم يستجب فأُجّل — للإحصاء ولتمييز المتأخر المتكرر.
  deferredCount         Int       @default(0)
  // عدد المرضى الذين يجب أن يُنادَوا قبل إعادة نداء هذا المتأخر (يُضبط على 2 عند التأجيل
  // ويُنقص بواحد مع كل مناداة، فيعود دوره تلقائيًا بعد مريضين).
  skipCredits           Int       @default(0)
  arrivedAt             DateTime?
  endedAt               DateTime?
  durationMinutes       Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  services AppointmentService[]
  review   Review?
  // سجل محاولة إرسال SMS "لم يحضر" الخاص بهذا الموعد (إن وُجد) — انظر SmsLog.
  smsLog   SmsLog?
  // تذكيرات Push للمريض صاحب الحساب (قبل ساعة وقبل 5 دقائق) — انظر AppointmentReminder.
  reminders AppointmentReminder[]
  // أحداث «متأخر» لهذا الموعد (سجل قابل للتتبّع، واحد لكل تأخير) — انظر AppointmentLateEvent.
  lateEvents AppointmentLateEvent[]
  // إشعارات داخل التطبيق المرتبطة بهذا الموعد (تنتهي بانتهاء يومه) — انظر Notification.
  notifications Notification[]

  // true ما دام الموعد يشغل وقته (كل الحالات عدا CANCELLED)، و NULL عند الإلغاء. القيد الفريد أدناه يشمله،
  // و NULL لا يتعارض في PostgreSQL: الموعد الملغى يبقى محفوظًا لكنه يحرّر وقته لحجز جديد، ويبقى
  // منع موعدين نشطين في نفس (طبيب + تاريخ + وقت) مضمونًا على مستوى قاعدة البيانات.
  // تُضبط في كل مسار إلغاء، ويحرسها trigger في قاعدة البيانات (انظر migration release_cancelled_slots).
  activeSlot Boolean? @default(true)

  // ---- الحساب العائلي ----
  // patientId يبقى صاحب الحساب والمسؤول عن الحجز؛ familyMemberId (اختياري) = المستفيد من الموعد.
  // فارغ = الموعد لصاحب الحساب نفسه (السلوك السابق كما هو).
  familyMemberId String?
  familyMember   FamilyMember? @relation(fields: [familyMemberId], references: [id], onDelete: Restrict)

  // ---- موعد العودة الذي يبرمجه الطبيب ----
  // الموعد الأصلي لا يُعدَّل أبدًا؛ موعد العودة موعد مستقل مرتبط به. حذف الأصلي (نادر) لا يحذف العودة.
  parentAppointmentId String?
  parentAppointment   Appointment?  @relation("FollowUpOf", fields: [parentAppointmentId], references: [id], onDelete: SetNull)
  followUps           Appointment[] @relation("FollowUpOf")
  treatmentPlanId     String?
  treatmentPlan       DentalTreatmentPlan?    @relation(fields: [treatmentPlanId], references: [id], onDelete: SetNull)
  treatmentSessionId  String?
  treatmentSession    DentalTreatmentSession? @relation("SessionFollowUps", fields: [treatmentSessionId], references: [id], onDelete: SetNull)
  // مصدر الإنشاء + الحساب الذي أنشأه (للتدقيق، بلا مفتاح أجنبي كي لا يضيع السجل إن حُذف الحساب).
  createdBy       AppointmentCreatedBy @default(PATIENT)
  createdByUserId String?
  // مفتاح منع التكرار عند إعادة إرسال نفس طلب «برمجة موعد عودة» (فريد لكل طبيب؛ NULL لا يتعارض).
  idempotencyKey  String?

  // الجلسة (من خطة علاج) التي يحققها هذا الموعد، والمتابعة التي حُوّلت إليه.
  treatmentSessionLink DentalTreatmentSession? @relation("SessionAppointment")
  dentalFollowUp       DentalFollowUp?

  @@unique([doctorId, date, startTime, activeSlot])
  @@unique([doctorId, idempotencyKey])
  @@index([patientId])
  @@index([doctorId, date])
  @@index([familyMemberId])
  @@index([parentAppointmentId])
  // إحصائية الحجوزات الشهرية العامة: نطاق createdAt (+ الحالة).
  @@index([createdAt, status])
  @@map("appointments")
}

model AppointmentService {
  id            String         @id @default(uuid())
  appointmentId String
  appointment   Appointment    @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  serviceId     String
  service       MedicalService @relation(fields: [serviceId], references: [id])

  @@map("appointment_services")
}

// سجل محاولات إرسال SMS (حاليًا فقط تنبيه "لم يحضر"). سجل واحد فقط لكل موعد بفضل القيد
// الفريد على appointmentId — يمنع هذا إعادة الإرسال العشوائي المتكرر سواء نجحت المحاولة
// الأولى أم فشلت. عند الفشل نحتفظ بسبب الفشل في failureReason لغرض التتبع والتشخيص.
model SmsLog {
  id            String      @id @default(uuid())
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  phone         String
  status        SmsStatus
  failureReason String?
  sentAt        DateTime    @default(now())

  @@map("sms_logs")
}

// ---------------- Reviews ----------------

model Review {
  id            String      @id @default(uuid())
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  doctorId      String
  doctor        Doctor      @relation(fields: [doctorId], references: [id])
  patientId     String
  patient       Patient     @relation(fields: [patientId], references: [id])
  // 1..5 فقط (Zod + الخدمة + قيد CHECK reviews_rating_range في قاعدة البيانات، انظر migration add_review_guards).
  rating        Int
  // اختياري؛ الفارغ يُخزَّن NULL. التقييم نهائي: لا مسار تعديل، وtrigger يمنع UPDATE على قاعدة البيانات.
  comment       String?
  createdAt     DateTime    @default(now())

  @@index([doctorId])
  @@index([patientId])
  @@map("reviews")
}
// ---------------- Notifications ----------------

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // APPOINTMENT_CONFIRMED | APPOINTMENT_CANCELLED | APPOINTMENT_REMINDER | APPOINTMENT_CHANGED | ...
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  // إشعار مرتبط بموعد (حجز/إلغاء/تأكيد/متأخر/تذكير...): يحمل الموعد ويومه ولحظة انتهاء صلاحيته
  // (نهاية يوم الموعد بتوقيت الجزائر). بعد expiresAt لا يُعرض في مركز الإشعارات ويُحذف دوريًا.
  // الإشعارات العامة (رسائل، توثيق الحساب...) تبقى هذه الحقول فيها NULL فلا تنتهي ولا تُحذف.
  appointmentId   String?
  appointment     Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  appointmentDate DateTime?
  expiresAt       DateTime?
  // الطبيب الذي أُعلن عن انضمامه. وجوده مع القيد الفريد يمنع إرسال الإعلان نفسه
  // للمريض أكثر من مرة إذا أعادت الإدارة طلب التوثيق أو أُعيدت المحاولة.
  newDoctorId      String?
  newDoctor        Doctor? @relation("NewDoctorNotifications", fields: [newDoctorId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, expiresAt])
  @@index([appointmentId])
  @@index([newDoctorId])
  @@unique([userId, type, newDoctorId])
  @@map("notifications")
}

// ---------------- Favorites ----------------

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  doctorId  String
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, doctorId])
  @@map("favorites")
}

// ---------------- MedBook AI ----------------

model AiConversation {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  messages AiMessage[]

  @@map("ai_conversations")
}

model AiMessage {
  id                   String         @id @default(uuid())
  conversationId       String
  conversation         AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role                 String // "user" | "assistant"

// ============================================================
// MedBook — Prisma Schema
// PostgreSQL
// ============================================================

generator client {
  provider = "prisma-client-js"
  output   = "../backend/node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------- Enums ----------------

enum Role {
  PATIENT
  DOCTOR
  ADMIN
  // مساعد الطبيب: حساب دخول مستقل (بريد/كلمة مرور خاصين به) يعمل نيابة عن طبيب واحد
  // محدد (انظر نموذج Assistant أدناه)، بصلاحيات محدودة دون بيانات الطبيب المالية أو الإدارية.
  ASSISTANT
}

// حالة دعوة مساعد أرسلها الطبيب عبر البريد الإلكتروني. الرابط المُرسل للمساعد لا يحمل
// إلا رمزًا عشوائيًا (يُخزَّن هنا مُجزَّأً لا نصًا صريحًا، بنفس نمط RefreshToken.tokenHash)،
// ولا يمكن استعماله إلا مرة واحدة (يتحول إلى ACCEPTED فيُرفض أي استعمال لاحق).
enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum Gender {
  MALE
  FEMALE
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  // المريض الجالس الآن أمام الطبيب (نودي عليه ودخل).
  IN_PROGRESS
  // نودي عليه فلم يستجب: لا يُشطب، بل ينتظر في قائمة "متأخر" ويُعاد نداؤه لاحقًا.
  LATE
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

// حالة اشتراك الطبيب المدفوع في المنصة. UNPAID هي الحالة الافتراضية لكل طبيب جديد
// يسجّل من الآن فصاعدًا — لا يظهر للمرضى ولا يمكن حجز موعد معه حتى تصبح ACTIVE.
// الأطباء المسجَّلون قبل إضافة هذه الميزة يُثبَّتون على ACTIVE تلقائيًا (انظر ملف الترحيل)
// حتى لا يختفوا فجأة من الموقع. لا يوجد حاليًا أي واجهة دفع فعلية مرتبطة بهذا الحقل —
// إعداد تقني تمهيدي فقط، بانتظار حساب "تاجر إلكتروني" لدى بريد الجزائر (BaridiMob).
enum SubscriptionStatus {
  UNPAID
  ACTIVE
  EXPIRED
}

enum ConsultationType {
  IN_PERSON
  FOLLOW_UP
  ONLINE
}

// نتيجة محاولة إرسال SMS لتنبيه "لم يحضر" — سجل واحد فقط لكل موعد (انظر SmsLog أدناه)
// لمنع إعادة المحاولة العشوائية سواء نجحت المحاولة الأولى أم فشلت.
enum SmsStatus {
  SENT
  FAILED
}

// ---------------- Core identity ----------------

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  phone        String?  @unique
  passwordHash String
  role         Role
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  patient         Patient?
  doctor          Doctor?
  notifications   Notification[]
  auditLogs       AuditLog[]
  favorites       Favorite[]
  aiConversations AiConversation[]
  refreshTokens   RefreshToken[]
  pushSubscriptions PushSubscription[]
  assistant         Assistant?

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// ---------------- Geography ----------------

model Wilaya {
  id     String  @id @default(uuid())
  code   String  @unique
  nameAr String
  nameFr String?

  cities  City[]
  doctors Doctor[]
  clinics Clinic[]

  @@map("wilayas")
}

model City {
  id       String @id @default(uuid())
  nameAr   String
  wilayaId String
  wilaya   Wilaya @relation(fields: [wilayaId], references: [id], onDelete: Cascade)

  doctors Doctor[]
  clinics Clinic[]

  @@index([wilayaId])
  @@map("cities")
}

// ---------------- Medical taxonomy ----------------

model Specialty {
  id          String  @id @default(uuid())
  nameAr      String  @unique
  nameFr      String?
  icon        String?
  description String?

  doctors Doctor[]

  @@map("specialties")
}

model MedicalService {
  id          String @id @default(uuid())
  nameAr      String
  durationMin Int    @default(30)
  price       Int?

  appointmentServices AppointmentService[]

  @@map("medical_services")
}

model Clinic {
  id       String @id @default(uuid())
  nameAr   String
  address  String
  phone    String?
  wilayaId String
  wilaya   Wilaya @relation(fields: [wilayaId], references: [id])
  cityId   String
  city     City   @relation(fields: [cityId], references: [id])

  doctors Doctor[]

  @@index([wilayaId, cityId])
  @@map("clinics")
}

// ---------------- Patients & Doctors ----------------

model Patient {
  id        String    @id @default(uuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName String
  lastName  String
  birthDate DateTime?
  gender    Gender?
  cityId    String?

  appointments Appointment[]
  reviews      Review[]

  @@map("patients")
}
model Doctor {
  id          String    @id @default(uuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName   String
  lastName    String
  specialtyId String
  specialty   Specialty @relation(fields: [specialtyId], references: [id])
  clinicId    String?
  clinic      Clinic?   @relation(fields: [clinicId], references: [id])
  wilayaId    String
  wilaya      Wilaya    @relation(fields: [wilayaId], references: [id])
  cityId      String
  city        City      @relation(fields: [cityId], references: [id])
  bio         String?
  yearsExperience Int    @default(0)
  languages       String[] @default([])
  gender          Gender?
  phone           String?
  address         String?
  consultationFee Int?
  photoUrl        String?
  // إحداثيات موقع العيادة/الطبيب — اختيارية تمامًا (nullable)، تُستعمل فقط لحساب المسافة
  // من موقع المريض (Haversine) وفتح الملاحة نحو العيادة. لا تُملأ تلقائيًا؛ الطبيب يضبطها
  // بنفسه من إعدادات حسابه (زر "استخدم موقعي الحالي") — لا جيوكودينغ ولا خدمة مدفوعة.
  latitude        Float?
  longitude       Float?
  // مدة الجلسة بالدقائق — يحددها الطبيب، وعليها يبني النظام ترتيب المواعيد تلقائيًا.
  slotDurationMin Int                @default(7)
  verificationStatus VerificationStatus @default(PENDING)
  // اشتراك الطبيب المدفوع في المنصة — انظر تعليق enum SubscriptionStatus أعلاه.
  subscriptionStatus SubscriptionStatus @default(UNPAID)
  subscriptionExpiresAt DateTime?
  avgRating   Float    @default(0)
  reviewsCount Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  schedules    DoctorSchedule[]
  appointments Appointment[]
  reviews      Review[]
  documents    DoctorDocument[]
  favorites    Favorite[]
  assistants       Assistant[]
  assistantInvites AssistantInvite[]
  // محادثة الإدارة مع هذا الطبيب (واحدة فقط) — علاقة عكسية بلا أي عمود جديد في جدول doctors.
  conversation     DoctorConversation?

  @@index([specialtyId, wilayaId, cityId])
  @@map("doctors")
}

// ---------------- Assistants (staff accounts) ----------------

// مساعد طبيب — حساب دخول مستقل (User بدور ASSISTANT) مرتبط بطبيب واحد وعيادته.
// isActive هو مفتاح التعطيل الفوري: الطبيب يعطّله من "إدارة المساعدين" فيُقطع وصوله من
// الـ Backend مباشرة (انظر resolveActingDoctorId في backend/src/lib/actingDoctor.ts)،
// وليس فقط إخفاءه في الواجهة.
model Assistant {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  doctorId  String
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  firstName String
  lastName  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([doctorId])
  @@map("assistants")
}

// دعوة مساعد يُرسلها الطبيب لبريد إلكتروني محدد. tokenHash مُجزَّأ (SHA-256) لا نصًا
// صريحًا — الرابط الفعلي يُبنى في الواجهة من الرمز الخام الذي لا يُخزَّن أبدًا. صلاحية
// زمنية (expiresAt) وحالة (status) تمنعان إعادة استعمال رابط دعوة سبق قبوله أو انتهى.
model AssistantInvite {
  id         String       @id @default(uuid())
  doctorId   String
  doctor     Doctor       @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  email      String
  tokenHash  String       @unique
  status     InviteStatus @default(PENDING)
  expiresAt  DateTime
  createdAt  DateTime     @default(now())
  acceptedAt DateTime?
  revokedAt  DateTime?

  @@index([doctorId])
  @@map("assistant_invites")
}

model DoctorDocument {
  id        String   @id @default(uuid())
  doctorId  String
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  title     String
  fileUrl   String
  createdAt DateTime @default(now())

  @@map("doctor_documents")
}

// weekly recurring slots OR one-off exceptions (day off / extra day)
model DoctorSchedule {
  id            String    @id @default(uuid())
  doctorId      String
  doctor        Doctor    @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  dayOfWeek     Int? // 0=Sunday .. 6=Saturday, null when isException=true
  startTime     String // "08:00"
  endTime       String // "12:00"
  isException   Boolean   @default(false)
  exceptionDate DateTime? // specific calendar date
  isOff         Boolean   @default(false) // true => doctor unavailable that slot/date

  @@index([doctorId])
  @@map("doctor_schedules")
}

// ---------------- Appointments ----------------

model Appointment {
  id        String   @id @default(uuid())
  patientId String?
  patient   Patient? @relation(fields: [patientId], references: [id])
  // حجز الضيف (بدون حساب/تسجيل دخول): يُملأ عند patientId = null
  guestFirstName String?
  guestLastName  String?
  guestPhone     String?
  doctorId  String
  doctor    Doctor   @relation(fields: [doctorId], references: [id])
  date      DateTime // calendar date (time truncated to 00:00 UTC)
  startTime String // "09:00"
  endTime   String // "09:30"
  type      ConsultationType  @default(IN_PERSON)
  status    AppointmentStatus @default(PENDING)
  notes     String?
  // آخر وقت أُرسل فيه تذكير SMS تلقائي للمريض قبل موعده — null يعني لم يُرسل بعد.
  // نستعملها لتفادي إرسال أكثر من تذكير واحد لنفس الموعد.
  reminderSentAt DateTime?
  // ---- إدارة طابور العيادة اليومي ----
  // وقت مناداة المريض من طرف الطبيب (آخر مناداة).
  calledAt              DateTime?
  // كم مرة نودي عليه فلم يستجب فأُجّل — للإحصاء ولتمييز المتأخر المتكرر.
  deferredCount         Int       @default(0)
  // عدد المرضى الذين يجب أن يُنادَوا قبل إعادة نداء هذا المتأخر (يُضبط على 2 عند التأجيل
  // ويُنقص بواحد مع كل مناداة، فيعود دوره تلقائيًا بعد مريضين).
  skipCredits           Int       @default(0)
  arrivedAt             DateTime?
  endedAt               DateTime?
  durationMinutes       Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  services AppointmentService[]
  review   Review?
  // سجل محاولة إرسال SMS "لم يحضر" الخاص بهذا الموعد (إن وُجد) — انظر SmsLog.
  smsLog   SmsLog?
  // تذكيرات Push للمريض صاحب الحساب (قبل ساعة وقبل 5 دقائق) — انظر AppointmentReminder.
  reminders AppointmentReminder[]

  @@unique([doctorId, date, startTime])
  @@index([patientId])
  @@index([doctorId, date])
  @@map("appointments")
}

model AppointmentService {
  id            String         @id @default(uuid())
  appointmentId String
  appointment   Appointment    @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  serviceId     String
  service       MedicalService @relation(fields: [serviceId], references: [id])

  @@map("appointment_services")
}

// سجل محاولات إرسال SMS (حاليًا فقط تنبيه "لم يحضر"). سجل واحد فقط لكل موعد بفضل القيد
// الفريد على appointmentId — يمنع هذا إعادة الإرسال العشوائي المتكرر سواء نجحت المحاولة
// الأولى أم فشلت. عند الفشل نحتفظ بسبب الفشل في failureReason لغرض التتبع والتشخيص.
model SmsLog {
  id            String      @id @default(uuid())
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  phone         String
  status        SmsStatus
  failureReason String?
  sentAt        DateTime    @default(now())

  @@map("sms_logs")
}

// ---------------- Reviews ----------------

model Review {
  id            String      @id @default(uuid())
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  doctorId      String
  doctor        Doctor      @relation(fields: [doctorId], references: [id])
  patientId     String
  patient       Patient     @relation(fields: [patientId], references: [id])
  rating        Int
  comment       String?
  createdAt     DateTime    @default(now())

  @@index([doctorId])
  @@map("reviews")
}
// ---------------- Notifications ----------------

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // APPOINTMENT_CONFIRMED | APPOINTMENT_CANCELLED | APPOINTMENT_REMINDER | APPOINTMENT_CHANGED | ...
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}

// ---------------- Favorites ----------------

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  doctorId  String
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, doctorId])
  @@map("favorites")
}

// ---------------- MedBook AI ----------------

model AiConversation {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  messages AiMessage[]

  @@map("ai_conversations")
}

model AiMessage {
  id                   String         @id @default(uuid())
  conversationId       String
  conversation         AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role                 String // "user" | "assistant"
  content              String
  suggestedSpecialtyId String?
  createdAt            DateTime       @default(now())

  @@map("ai_messages")
}

// ---------------- Audit ----------------

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String?
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("audit_logs")
}

// ---------------- Web Push ----------------

// اشتراك متصفح واحد في إشعارات Push (لكل جهاز/متصفح سجل مستقل، فقد يستعمل الطبيب
// هاتفه وحاسوبه معًا). endpoint فريد لأنه هو معرّف الاشتراك لدى خدمة الدفع في المتصفح.
// عند رفض الخدمة للاشتراك (410/404) نحذف السجل تلقائيًا لأنه لم يعد صالحًا.
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("push_subscriptions")
}

// ---------------- Admin <-> Doctor messaging ----------------

// محادثة واحدة فقط لكل طبيب (doctorId فريد) بين الإدارة (كل حسابات ADMIN كفريق واحد) والطبيب.
// لا توجد محادثات طبيب-طبيب ولا محادثات مع مساعد أو مريض: لا مفتاح خارجي ولا مسار يسمح بذلك.
// lastMessage* حقول مُكرَّرة عمدًا لعرض قائمة المحادثات بلا استعلام لكل صف (لا N+1).
model DoctorConversation {
  id                 String    @id @default(uuid())
  doctorId           String    @unique
  doctor             Doctor    @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  lastMessageAt      DateTime?
  lastMessagePreview String?
  lastSenderRole     Role?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  messages DoctorMessage[]

  @@index([lastMessageAt])
  @@map("doctor_conversations")
}

// senderId يُشتق دائمًا من الجلسة في الخادم (لا يأتي من الواجهة). senderRole إمّا ADMIN أو DOCTOR فقط.
// clientId: معرّف يولّده العميل لكل رسالة لمنع التكرار عند إعادة الطلب/انقطاع الشبكة.
// readAt: وقت قراءة الطرف الآخر للرسالة (null = غير مقروءة).
model DoctorMessage {
  id             String             @id @default(uuid())
  conversationId String
  conversation   DoctorConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  senderRole     Role
  content        String
  clientId       String?
  readAt         DateTime?
  createdAt      DateTime           @default(now())

  @@unique([conversationId, senderId, clientId])
  @@index([conversationId, createdAt])
  @@index([senderRole, readAt])
  @@map("doctor_messages")
}

// ---------------- Patient appointment reminders (Web Push) ----------------

// نوع التذكير: قبل الموعد بساعة، وقبل الموعد بخمس دقائق. لا يوجد تذكير 24 ساعة.
enum ReminderType {
  ONE_HOUR
  FIVE_MINUTES
}

// PENDING: أُنشئ ولم يُعالَج بعد. PROCESSING: حجزه مُشغِّل واحد (قفل ذرّي عبر updateMany المشروط).
// SENT: وصل لجهاز واحد على الأقل. SKIPPED: لم يُرسل عمدًا (موعد ملغى/مكتمل/غائب، فات الوقت، لا أجهزة).
// FAILED: رفضته كل الأجهزة. أي حالة غير PENDING نهائية: لا يُعاد إرسال التذكير أبدًا.
enum ReminderStatus {
  PENDING
  PROCESSING
  SENT
  SKIPPED
  FAILED
}

// تذكير واحد لكل (موعد + نوع) بفضل القيد الفريد، فلو اشتغل الـscheduler مرتين أو على نسختين
// من الخادم في نفس اللحظة لا يُنشأ ولا يُرسل نفس التذكير مرتين. لا يحمل أي بيانات طبية.
model AppointmentReminder {
  id            String         @id @default(uuid())
  appointmentId String
  appointment   Appointment    @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  type          ReminderType
  scheduledFor  DateTime
  status        ReminderStatus @default(PENDING)
  sentAt        DateTime?
  // عدد الأجهزة التي وصلها الإشعار، وسبب التخطي/الفشل (نص تقني قصير، بلا بيانات شخصية).
  deliveredCount Int           @default(0)
  skipReason    String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([appointmentId, type])
  @@index([status, scheduledFor])
  @@map("appointment_reminders")
}

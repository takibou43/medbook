# ============================================
# MedBook — متغيرات البيئة (نسخ إلى .env وتعبئتها)
# لا تضع القيم الحقيقية في Git أبدًا
# ============================================

# --- قاعدة البيانات ---
DATABASE_URL="postgresql://medbook:medbook@localhost:5432/medbook?schema=public"

# --- Backend ---
PORT=4000
NODE_ENV=development
CLIENT_URL="http://localhost:5173"

# JWT
JWT_SECRET="ضع_قيمة_عشوائية_طويلة_وسرية_هنا"
JWT_REFRESH_SECRET="ضع_قيمة_عشوائية_أخرى_مختلفة_هنا"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1500
# عدد وسطاء الـproxy الموثوقين (Render = 1) — لازم ليُحسب حدّ الطلبات لكل عميل لا للخادم كله
TRUST_PROXY_HOPS=1

# --- طبقة الذكاء الاصطناعي (اختياري) ---
# اتركه فارغًا لاستخدام المزوّد الاحتياطي القائم على القواعد (Rule-Based)
# أو ضع مفتاح مزود خارجي (مثل Anthropic/OpenAI) لتفعيل الردود الذكية الكاملة
AI_PROVIDER="mock"        # mock | anthropic | openai
AI_API_KEY=""
AI_MODEL=""

# --- إشعارات Push (Web Push / VAPID) ---
# تُولَّد مرة واحدة: npx web-push generate-vapid-keys — المفتاح الخاص سرّ للخادم فقط، لا يوضع في الواجهة ولا في Git.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:support@medbook.dz"

# --- تذكيرات مواعيد المرضى (قبل ساعة وقبل 5 دقائق) ---
# المُجدوِل يعمل داخل الخادم كل دقيقة. false يوقفه دون تعديل الكود.
REMINDERS_ENABLED=true
# سرّ اختياري لتشغيل الدورة من مُجدوِل خارجي: POST /api/internal/reminders/run بالترويسة X-Cron-Secret.
# فارغ = المسار معطّل (404). لا تضع القيمة الحقيقية هنا.
REMINDER_CRON_SECRET=""

# --- Frontend (Vite) ---
VITE_API_URL="http://localhost:4000/api"
